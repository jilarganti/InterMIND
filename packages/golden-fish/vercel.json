{
  "cleanUrls": true,

  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "goldenfish.ae" }],
      "destination": "https://mind.com/",
      "statusCode": 308
    }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=31536000, immutable"
        }
      ]
    }
  ]
}
