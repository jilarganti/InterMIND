{
  "name": "mind-com",
  "description": "Live speech translation in video calls",
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev:FE": "vitepress dev docs",
    "dev:BE": "vercel dev --listen 3100",
    "dev": "pnpm dev:FE & pnpm dev:BE",
    "prebuild": "pnpm run index:docs && pnpm run test:unit",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "test": "vitest --run --coverage",
    "test:unit": "vitest --run __tests__/unit",
    "test:watch": "vitest",
    "test:traffic-sources": "tsx __tests__/test-traffic-sources.ts",
    "translate": "tsx ../../scripts/translate.ts ./scripts/translateConfig.ts",
    "translate:check": "../../scripts/check-translation-balance.sh",
    "index:docs": "tsx ./scripts/indexDocs.ts",
    "medium-scraper": "tsx ./scripts/medium-to-markdown.ts",
    "format": "prettier --cache --cache-strategy content -w .",
    "lint": "pnpm eslint --cache .",
    "audit": "pnpm audit --audit-level=moderate"
  },
  "dependencies": {
    "shared": "workspace:*",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.5",
    "axios": "^1.12.2",
    "markdown-it-task-lists": "^2.1.1",
    "simple-git-hooks": "^2.13.1",
    "puppeteer": "^24.22.3",
    "turndown": "^7.2.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm audit && pnpm build"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --cache --fix"
    ],
    "*.{ts,vue}": [
      "vitest related --run --project=unit"
    ]
  }
}
