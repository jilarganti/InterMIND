{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).png",
      "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).webp",
      "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).jpg",
      "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }]
    }
  ],

  "redirects": [
    {
      "source": "/blog/posts/Multilingual-Meetings-in-Microsoft-Teams",
      "destination": "/blog/multilingual-meetings-in-microsoft-teams",
      "permanent": true
    },
    {
      "source": "/blog/posts/2025/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog/posts/2026/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog/posts/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog/posts",
      "destination": "/blog",
      "permanent": true
    },

    {
      "source": "/resources/company/privacy-policy",
      "destination": "/legal/privacy",
      "permanent": true
    },
    {
      "source": "/resources/company/legal-regulations-for-ai-services",
      "destination": "/legal/terms",
      "permanent": true
    },
    {
      "source": "/resources/company/about",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/resources/company/team",
      "destination": "https://intermind.com/team",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "https://intermind.com/team",
      "permanent": true
    },
    {
      "source": "/:locale(es|pt|fr|de|ru|zh)/team",
      "destination": "https://intermind.com/team",
      "permanent": true
    },
    {
      "source": "/resources/company/contacts",
      "destination": "/contacts",
      "permanent": true
    },
    {
      "source": "/resources/help",
      "destination": "/help",
      "permanent": true
    },
    {
      "source": "/resources/media-kit",
      "destination": "/brand-assets",
      "permanent": true
    },

    {
      "source": "/:locale(ar|hi|id|ja|ko|ta|tr|vi)/:path*",
      "destination": "https://intermind.com/",
      "permanent": true
    },

    {
      "source": "/product/:path*",
      "destination": "https://intermind.com/",
      "permanent": true
    },
    {
      "source": "/ru/product/:path*",
      "destination": "https://intermind.com/",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "https://intermind.com/",
      "permanent": true
    },

    {
      "source": "/account/:path*",
      "destination": "https://intermind.com/login",
      "permanent": true
    },

    {
      "source": "/promo/:path*",
      "destination": "https://intermind.com/promo/:path*",
      "permanent": true
    },
    {
      "source": "/ru/promo/:path*",
      "destination": "https://intermind.com/promo/:path*",
      "permanent": true
    },
    {
      "source": "/exp/:path*",
      "destination": "https://intermind.com/",
      "permanent": true
    },

    {
      "source": "/chat",
      "destination": "https://intermind.com/",
      "permanent": true
    },
    {
      "source": "/company/about",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/company/news/:path*",
      "destination": "/blog",
      "permanent": true
    },

    {
      "source": "/solutions/:path*",
      "destination": "https://intermind.com/",
      "permanent": true
    },
    {
      "source": "/imind",
      "destination": "https://intermind.com/",
      "permanent": true
    },
    {
      "source": "/plans",
      "destination": "https://intermind.com/",
      "permanent": true
    },
    {
      "source": "/form/:path*",
      "destination": "/contacts",
      "permanent": true
    },

    {
      "source": "/patents",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/company-customers",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/trust",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/training",
      "destination": "/",
      "permanent": true
    }
  ]
}
